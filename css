
/* ===== VARIÁVEIS CSS ===== */
:root {
    --cor-primaria: #6C63FF;
    --cor-primaria-escura: #5a52d5;
    --cor-fundo: #f5f7fa;
    --cor-texto: #1a1a2e;
    --cor-texto-claro: #555;
    --cor-branca: #fff;
    --cor-cinza: #e0e0e0;
    --cor-header: #1a1a2e;
    --espacamento: 1rem;
    --espacamento-grande: 2rem;
    --raio: 12px;
    --sombra: 0 2px 10px rgba(0,0,0,0.05);
}

/* ===== RESET ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* ===== ESTILOS BASE (MOBILE-FIRST) ===== */
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* ===== HEADER - STICKY ===== */
header {
    background: var(--cor-header);
    padding: 0.8rem 1rem;
    position: sticky;
    top: 0;
    z-index: 100;
}

nav {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
}

.logo {
    color: #fff;
    font-size: 1.2rem;
    font-weight: bold;
}

.menu {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
}

.menu a {
    color: #ccc;
    text-decoration: none;
    padding: 0.3rem 0;
    font-size: 0.8rem;
    transition: color 0.3s;
    position: relative;
}

/* Pseudo-elementos */
.menu a::before {
    content: '▸';
    color: var(--cor-primaria);
    opacity: 0;
    transition: opacity 0.3s;
}

.menu a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--cor-primaria);
    transition: width 0.3s;
}

.menu a:hover {
    color: #fff;
}

.menu a:hover::before {
    opacity: 1;
}

.menu a:hover::after {
    width: 100%;
}

.menu a.active {
    color: var(--cor-primaria);
}

.menu a.active::after {
    width: 100%;
}

/* ===== CONTEÚDO ===== */
main {
    flex: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem;
    width: 100%;
}

/* ===== HOME ===== */
.perfil {
    text-align: center;
}

.perfil figure {
    margin-bottom: 0.8rem;
}

.foto-perfil {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--cor-primaria);
    transition: transform 0.3s;
}

/* Animação */
@keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(108, 99, 255, 0.4); }
    70% { box-shadow: 0 0 0 15px rgba(108, 99, 255, 0); }
    100% { box-shadow: 0 0 0 0 rgba(108, 99, 255, 0); }
}

.foto-perfil:hover {
    animation: pulse 1.5s ease-in-out;
    transform: scale(1.05);
}

.perfil figcaption {
    font-size: 0.8rem;
    color: #777;
    font-style: italic;
}

h1 {
    font-size: 1.8rem;
    margin-bottom: 0.3rem;
}

h2 {
    font-size: 1.6rem;
    border-bottom: 3px solid var(--cor-primaria);
    padding-bottom: 0.3rem;
    margin-bottom: 1rem;
}

h3 {
    color: var(--cor-primaria);
    margin: 1rem 0 0.3rem;
    font-size: 1.1rem;
}

p {
    margin-bottom: 0.3rem;
    color: var(--cor-texto-claro);
}

.tagline {
    font-size: 1rem;
    color: var(--cor-primaria);
    font-style: italic;
}

.btn {
    display: inline-block;
    background: linear-gradient(135deg, var(--cor-primaria), var(--cor-primaria-escura));
    color: #fff;
    padding: 0.6rem 1.8rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    margin: 0.8rem 0;
    transition: transform 0.3s, box-shadow 0.3s;
    box-shadow: 0 4px 15px rgba(108, 99, 255, 0.3);
}

.btn:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 25px rgba(108, 99, 255, 0.4);
}

/* ===== MULTIMÉDIA ===== */
.multimedia {
    margin: 1.5rem 0;
    padding-top: 1rem;
    border-top: 2px solid #eee;
}

video {
    width: 100%;
    max-width: 100%;
    border-radius: 10px;
    aspect-ratio: 16/9;
    box-shadow: var(--sombra);
}

audio {
    width: 100%;
    max-width: 100%;
    margin-top: 0.3rem;
}

/* ===== LISTAS ===== */
ul {
    list-style: none;
    margin-bottom: 0.5rem;
}

ul li {
    padding: 0.2rem 0;
    color: var(--cor-texto-claro);
}

ul li strong {
    color: var(--cor-texto);
}

/* ===== TABELA ===== */
table {
    width: 100%;
    border-collapse: collapse;
    background: var(--cor-branca);
    border-radius: 10px;
    overflow: hidden;
    margin: 0.5rem 0 1rem;
    font-size: 0.9rem;
}

thead {
    background: linear-gradient(135deg, var(--cor-primaria), var(--cor-primaria-escura));
    color: #fff;
}

th, td {
    padding: 0.5rem 0.8rem;
    text-align: left;
}

tbody tr:nth-child(even) {
    background: #f8f7ff;
}

tbody tr:hover {
    background: #f0eeff;
}

tbody tr:last-child td {
    border-bottom: none;
}

/* ===== PORTFÓLIO - CSS GRID ===== */
.grid-projetos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

.grid-projetos figure {
    background: var(--cor-branca);
    border-radius: var(--raio);
    overflow: hidden;
    box-shadow: var(--sombra);
    text-align: center;
    padding-bottom: 0.8rem;
    transition: transform 0.3s, box-shadow 0.3s;
}

.grid-projetos figure:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(108, 99, 255, 0.15);
}

.grid-projetos img {
    width: 100%;
    height: 160px;
    object-fit: cover;
}

.grid-projetos h3 {
    color: var(--cor-primaria);
    margin: 0.5rem 0 0.2rem;
    font-size: 1rem;
}

.grid-projetos p {
    padding: 0 0.8rem;
    font-size: 0.85rem;
}

.grid-projetos small {
    color: #999;
    font-size: 0.75rem;
}

/* ===== HOBBIES - FLEXBOX ===== */
.flex-hobbies {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 0.8rem;
}

.flex-hobbies div {
    background: var(--cor-branca);
    border-radius: var(--raio);
    padding: 1rem;
    box-shadow: var(--sombra);
    border-top: 4px solid var(--cor-primaria);
    flex: 0 1 130px;
    min-width: 110px;
    max-width: 160px;
    text-align: center;
    transition: transform 0.3s;
}

.flex-hobbies div:hover {
    transform: translateY(-5px) scale(1.02);
}

.flex-hobbies span {
    font-size: 2rem;
    display: block;
}

.flex-hobbies h3 {
    color: var(--cor-primaria);
    font-size: 0.9rem;
    margin: 0.2rem 0;
}

.flex-hobbies p {
    font-size: 0.8rem;
    margin: 0;
}

/* ===== CONTACTO ===== */
article, aside {
    background: var(--cor-branca);
    border-radius: var(--raio);
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: var(--sombra);
    border-left: 4px solid var(--cor-primaria);
}

aside {
    border-left-color: #ff6b6b;
}

.contacto-info a {
    color: var(--cor-primaria);
    text-decoration: none;
}

.contacto-info a:hover {
    text-decoration: underline;
}

/* ===== FORMULÁRIO ===== */
fieldset {
    border: 2px solid var(--cor-primaria);
    border-radius: var(--raio);
    padding: 1rem;
    margin: 1rem 0;
}

legend {
    color: var(--cor-primaria);
    font-weight: bold;
    padding: 0 0.5rem;
}

form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

form label {
    font-weight: 600;
    font-size: 0.85rem;
}

/* Seletor de atributo */
input[type="text"],
input[type="email"],
input[type="tel"],
input[type="date"],
input[type="number"],
input[type="file"],
select,
textarea {
    padding: 0.6rem 0.8rem;
    border: 2px solid var(--cor-cinza);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    width: 100%;
    transition: border-color 0.3s;
}

/* Pseudo-classes :focus e :invalid */
input:focus,
select:focus,
textarea:focus {
    border-color: var(--cor-primaria);
    outline: none;
}

input:invalid:not(:placeholder-shown),
textarea:invalid:not(:placeholder-shown) {
    border-color: #ff6b6b;
}

/* Radio e Checkbox estilizados */
input[type="radio"],
input[type="checkbox"] {
    margin-right: 0.3rem;
}

form button {
    background: linear-gradient(135deg, var(--cor-primaria), var(--cor-primaria-escura));
    color: #fff;
    border: none;
    padding: 0.7rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
    margin-top: 0.3rem;
}

form button:hover {
    transform: scale(1.02);
    box-shadow: 0 6px 25px rgba(108, 99, 255, 0.3);
}

/* ===== RODAPÉ ===== */
footer {
    background: var(--cor-header);
    color: #aaa;
    text-align: center;
    padding: 1rem;
    margin-top: auto;
}

footer a {
    color: var(--cor-primaria);
    text-decoration: none;
}

footer a:hover {
    text-decoration: underline;
}

footer p {
    margin: 0.2rem 0;
    color: #aaa;
    font-size: 0.85rem;
}

/* ============================================================
   MEDIA QUERIES (mobile-first - ampliando para ecrãs maiores)
   ============================================================ */

/* TABLET (min-width: 769px) */
@media (min-width: 769px) {
    header {
        padding: 1rem 2rem;
    }

    nav {
        flex-direction: row;
        justify-content: space-between;
    }

    .logo {
        font-size: 1.5rem;
    }

    .menu a {
        font-size: 0.95rem;
        padding: 0.5rem 0;
    }

    main {
        padding: 2rem;
    }

    h1 {
        font-size: 2.5rem;
    }

    h2 {
        font-size: 2rem;
    }

    .foto-perfil {
        width: 160px;
        height: 160px;
    }

    .grid-projetos {
        grid-template-columns: repeat(2, 1fr);
    }

    .flex-hobbies div {
        flex: 0 1 160px;
        min-width: 130px;
        max-width: 200px;
        padding: 1.2rem;
    }

    .flex-hobbies span {
        font-size: 2.5rem;
    }

    video {
        max-width: 500px;
    }

    audio {
        max-width: 400px;
    }

    .grid-projetos img {
        height: 180px;
    }
}

/* DESKTOP (min-width: 1025px) */
@media (min-width: 1025px) {
    .grid-projetos {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .grid-projetos img {
        height: 200px;
    }

    .flex-hobbies {
        gap: 1.2rem;
    }

    .flex-hobbies div {
        flex: 0 1 180px;
        min-width: 150px;
        max-width: 220px;
        padding: 1.5rem;
    }

    .flex-hobbies span {
        font-size: 3rem;
    }

    video {
        max-width: 600px;
    }

    audio {
        max-width: 500px;
    }
}
